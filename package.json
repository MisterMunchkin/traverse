{
  "name": "@mistermunchkin/traverse",
  "version": "0.12.0",
  "private": true,
  "description": "Reviewed repository navigation graphs and bounded agent-device driving; unpublished",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "exports": {
    "./source/navigation": "./src/source/navigation.mjs",
    "./source/ast": "./src/source/ast.mjs",
    "./runtime/process": "./src/runtime/process.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:package": "node scripts/package-smoke.mjs",
    "release:pack": "node scripts/release.mjs pack",
    "release:verify": "node scripts/release.mjs verify",
    "check:site": "node scripts/site.mjs check",
    "site:build": "node scripts/site.mjs build",
    "site:preview": "node scripts/site.mjs preview"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "bin": {
    "traverse": "bin/traverse.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "fixtures/",
    "install.sh",
    "npm-shrinkwrap.json",
    "README.md",
    "docs/"
  ],
  "license": "MIT",
  "devDependencies": {
    "netlify-cli": "27.16.1"
  }
}
